# ---------------------------------------------------------------------------
# This app is a pure client-side SPA. Every variable here is compiled into the
# JavaScript bundle and is therefore PUBLIC. Never put a secret in this file.
#
# In particular: no SUPABASE_SECRET_KEY / service-role key, no Upstash token,
# no Resend key, no AWS credentials. Access control is enforced by Postgres
# row-level security in Supabase, not by this app.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Where Supabase should send the user back to after an OAuth round-trip.
# Must be listed under Authentication -> URL Configuration -> Redirect URLs.
VITE_SITE_URL=http://localhost:3000

# Feature flags - "1" enables, anything else disables.
VITE_AUTH_ENABLED=1
VITE_LOGIN_EMAIL_AUTH_ENABLED=1
VITE_REGISTER_EMAIL_AUTH_ENABLED=1
VITE_FORGOT_PASSWORD_ENABLED=1
VITE_RESET_PASSWORD_ENABLED=1
VITE_GOOGLE_AUTH_ENABLED=1
