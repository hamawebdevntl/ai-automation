# Lambda image for the light activities: submit, poll, copy, publish,
# poll-publish, the webhook bridges and the reconcilers.
#
# Deliberately without ffmpeg. Only fetch_and_qc touches the video itself, and
# it runs from Dockerfile.media with more memory and a longer timeout; sizing
# everything else for that would be waste.
FROM public.ecr.aws/lambda/python:3.12

COPY pyproject.toml ${LAMBDA_TASK_ROOT}/
COPY pipeline ${LAMBDA_TASK_ROOT}/pipeline

RUN python -m pip install --no-cache-dir --upgrade pip \
 && python -m pip install --no-cache-dir "${LAMBDA_TASK_ROOT}" \
 && python -m compileall -q "${LAMBDA_TASK_ROOT}/pipeline"

CMD ["pipeline.handler.lambda_handler"]
