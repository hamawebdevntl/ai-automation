# The pipeline's configuration. Copy to `.env` and fill in.
#
# This replaces the `reels/pipeline` AWS Secrets Manager bundle. That bundle
# existed because Lambda cannot inject a Secrets Manager value into an
# environment variable, and a service-role key sitting in a plain Lambda env var
# is readable to anyone with GetFunctionConfiguration -- so only the ARN was
# passed in and the JSON was fetched at cold start. On a machine we control an
# env file is the same secret with one fewer service in front of it.
#
# Docker Compose reads this file directly (`env_file:`). For a local run outside
# Compose, source it: `set -a && . ./.env && set +a`.

# --- Supabase (required) -----------------------------------------------------
# The service role bypasses row-level security, which is the only reason the
# pipeline can write `ideas` and `productions` at all -- those tables
# deliberately have no INSERT or UPDATE policy. Keep this key out of anything
# that reaches a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- MoneyPrinterTurbo -------------------------------------------------------
# Compose sets MPT_BASE_URL to the service address; set it here only for a local
# run against an MPT started by hand (http://127.0.0.1:8080).
# MPT_BASE_URL=
# Must match `app.api_key` in MoneyPrinterTurbo's own config. A long random
# string; the fork compares it in constant time.
MPT_API_KEY=

# --- Publishing --------------------------------------------------------------
# False until Postiz is deployed and its channels are connected. With it off,
# `publish`, `poll_publish` and `collect_analytics` are never reached, and an
# approved production rests at status='approved' holding its finished cut and
# its per-platform copy -- a backlog to release later, not a batch that was
# lost. See docs/DEPLOY.md.
PUBLISHING_ENABLED=false
# POSTIZ_BASE_URL=
# POSTIZ_API_KEY=

# --- Idea generation ---------------------------------------------------------
# Which model drafts the Gate 1 queue. The provider is normally
# `trend_settings.idea_provider`, edited in the app; this is the fallback for
# when that column is blank or the table cannot be read.
IDEA_LLM_PROVIDER=claude
# Read by the Anthropic SDK itself, which is why there is no config field for
# it: a second source of truth for one key is how a key ends up set in the place
# that is not read.
ANTHROPIC_API_KEY=
# Only needed when IDEA_LLM_PROVIDER=gemini. Free from aistudio.google.com,
# which is the point of this lane -- it makes a demo possible with no billing
# account.
GEMINI_API_KEY=

# --- Render backends ---------------------------------------------------------
# Selected per style preset via `style_presets.render_mode`, so nothing here
# decides which backend a video uses -- only whether a lane can run at all.
#
# fal: sent as `Authorization: Key ...`, not Bearer.
FAL_API_KEY=
# HeyGen: sent raw in `X-Api-Key`, not as a bearer token. Bills per render
# against a pay-as-you-go wallet, so the balance is a hard ceiling.
HEYGEN_API_KEY=

# How long the signed URL to an owner's uploaded footage stays valid, on the
# `fal_video` lane. This has to outlive the whole render rather than the submit:
# the provider fetches the file when the job leaves the queue, so a lifetime
# sized for the submit expires under a job that is queued behind someone else's
# and the render fails having already been billed. The default is six hours
# against a thirty-minute poll budget, and `_submit_fal_video` refuses to submit
# at all if this is not longer than FAL_POLL_BUDGET_SECONDS.
SOURCE_VIDEO_URL_TTL_SECONDS=21600

# --- Trend research ----------------------------------------------------------
# Only the selected source's credential is needed, and it is checked before
# scouting starts rather than at the point of use -- which matters most on
# Apify, where finding out afterwards means having paid for a scrape whose
# results were then thrown away.
#
# Apify bills per result. Console -> Settings -> Integrations.
APIFY_TOKEN=
# A Google Cloud key with "YouTube Data API v3" enabled. Quota'd rather than
# billed: 10,000 units a day, and a search costs 100.
YOUTUBE_API_KEY=

# The brief and the term lists live in `trend_settings` and are edited under
# Settings in the app. These are the fallback for a database that cannot be
# read. A run with no brief from either source is a hard failure, deliberately:
# a trend run without one produces plausible, irrelevant ideas, and each costs
# the owner a review and possibly a render.
NICHE_BRIEF=
TREND_HASHTAGS=
TREND_KEYWORDS=

# --- Intelligent clipping ----------------------------------------------------
# The lane that cuts an uploaded recording down rather than generating anything.
# It calls no render provider at all: everything is ffmpeg on a file already in
# our own bucket. The two paid calls happen once per *upload*, before the gate --
# a transcription (FAL_API_KEY, FAL_TRANSCRIBE_MODEL above) and one structured
# LLM call (IDEA_LLM_PROVIDER above). Nothing per clip.
#
# How long to wait for a transcript. Far longer than the captioning path's, which
# transcribes forty seconds of narration: here the input is the whole recording,
# and the job queues behind everything else in the fal account.
# CLIP_TRANSCRIBE_BUDGET_SECONDS=2700
# How long a worker's claim on one recording survives unrenewed. Must exceed the
# transcribe budget, or a lease expiring mid-transcription hands the row to a
# second worker and pays fal twice for one file.
# CLIP_LEASE_SECONDS=3600
# The longest recording that will be transcribed. A ceiling on the one cost that
# scales with the owner's file rather than with our settings: refused before the
# bill, not after. Four hours is generous for a talk, a webinar or a podcast.
# CLIP_MAX_SOURCE_SECONDS=14400

# --- The driver --------------------------------------------------------------
# What used to be Step Functions' concern. Defaults are sensible; override only
# if you have a reason.
#
# Threads advancing productions. Two, because the failure to avoid is a
# multi-minute fetch-and-check stalling every other production's poll.
# PRODUCTION_WORKERS=2
# How long an idle worker waits before asking for work again. This is the Gate 2
# latency: what stands between an owner clicking approve and the row moving.
# DRIVER_POLL_SECONDS=5
# How long a claim survives. Long enough that an ordinary step never loses its
# row mid-flight, short enough that a worker killed by the OOM reaper does not
# hold a production hostage.
# LEASE_SECONDS=900
# WORKER_ID=

LOG_LEVEL=INFO
