# Fargate image for the scheduled trend run.
#
# Not a Lambda. TikTok-Api signs every request inside a live Playwright page,
# so each session is a real browser process -- memory-hungry, slow to start,
# and prone to being wedged by bot detection. Isolating it means a stuck
# browser cannot stall renders or publishing.
FROM mcr.microsoft.com/playwright/python:v1.49.0-jammy

WORKDIR /app
COPY pyproject.toml /app/
COPY pipeline /app/pipeline

RUN python -m pip install --no-cache-dir --upgrade pip \
 && python -m pip install --no-cache-dir ".[trends]" \
 && python -m playwright install --with-deps chromium

# Runs once and exits; EventBridge Scheduler starts it on a cadence.
ENTRYPOINT ["python", "-m", "pipeline.trends.runner"]
